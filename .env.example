# Database: DATABASE_URL (preferred, e.g. Railway) or the discrete DB_* values.
# Leave DATABASE_URL unset locally unless you want to use that database.
DATABASE_URL=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Tracking_db

PORT=4000
NODE_ENV=development

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Public site URL (used in tracking links, QR codes and emails) and allowed browser origins.
FRONTEND_URL=https://velizon.com
FRONTEND_URL_WWW=https://www.velizon.com
ALLOWED_ORIGINS=http://localhost:5173,https://velizon.com,https://www.velizon.com

# Email (Postmark). Without a server token no emails are sent.
# FROM_EMAIL must be on a domain verified in Postmark (Sender Signatures -> add domain, then add its DKIM and Return-Path DNS records).
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
FROM_EMAIL=support@velizon.com
ADMIN_EMAIL=

# Printed on documents and emails.
SUPPORT_EMAIL=support@velizon.com
SUPPORT_PHONE=+1 (315) 202-9671

# Postal address shown on documents (until set in the staff console) and in email footers.
COMPANY_ADDRESS=1 World Way, Los Angeles, CA 90045, USA
